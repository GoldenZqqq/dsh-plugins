{
  "name": "dsh-heartbeat",
  "version": "1.0.2",
  "description": "DSH web plugin: a living heart-rate monitor — token-output speed drives a real ECG, a vitals HUD, and a pathology state machine (arrhythmia on errors, ectopic beats on retries, apnea while waiting).",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoldenZqqq/dsh-plugins.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "heartbeat",
    "ecg",
    "monitor",
    "ui"
  ],
  "author": "superzhang21 (upstream), GoldenZqqq (maintainer)",
  "dshCompat": {
    "tested": [
      "0.2.1-rc.3"
    ],
    "range": ">=0.2.0 <0.3.0",
    "verifiedAt": "2026-10-29",
    "dependsOn": [
      "client:connection.state",
      "client:sessions.list",
      "client:remote.session.follow(assistantStream)",
      "client:event:assistant-stream",
      "client:event:assistant/live-chunk",
      "client:event:llm/retry",
      "client:event:turn/end"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
