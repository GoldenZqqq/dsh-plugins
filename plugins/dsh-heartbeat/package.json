{
  "name": "dsh-heartbeat",
  "version": "1.0.0",
  "description": "DSH web plugin: a living heart-rate monitor — token-output speed drives a real ECG, a vitals HUD, and a pathology state machine (arrhythmia on errors, ectopic beats on retries, apnea while waiting).",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoldenZqqq/dsh-plugins.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "heartbeat",
    "ecg",
    "monitor",
    "ui"
  ],
  "author": "superzhang21 (upstream), GoldenZqqq (maintainer)",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
