{
  "name": "dsh-workspace-collapse",
  "version": "0.2.0",
  "description": "DSH web plugin: one button toggles collapse/expand of all workspace groups in the left sidebar.",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoldenZqqq/dsh-plugins.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "workspace",
    "collapse",
    "ui"
  ],
  "author": "GoldenZqqq",
  "dshCompat": {
    "tested": [
      "0.2.1-rc.3"
    ],
    "range": ">=0.1.7 <0.3.0",
    "verifiedAt": "2026-10-29",
    "dependsOn": [
      "dom:workspace-tree",
      "dom:role=treeitem[aria-expanded]"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
